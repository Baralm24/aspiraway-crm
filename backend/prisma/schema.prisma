generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum RoleName {
  ADMIN
  MENTOR
  STUDENT
}

enum StudentStatus {
  LEAD
  COUNSELING
  SHORTLISTING
  SOP
  APPLIED
  OFFER
  VISA
  DEPARTED
}

enum ApplicationStatus {
  APPLIED
  OFFER_RECEIVED
  REJECTED
}

enum DocumentType {
  SOP
  TRANSCRIPT
  PASSPORT
  VISA
  OTHER
}

enum MentorshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

//////////////////////
// AUTH MODELS
//////////////////////

model Role {
  id    String   @id @default(uuid())
  name  RoleName @unique
  users User[]
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String

  roleId String
  role   Role @relation(fields: [roleId], references: [id])

  studentProfile StudentProfile?
  mentorProfile  MentorProfile?

  isBlocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}




//////////////////////
// PROFILE MODELS
//////////////////////

model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  phone             String?
  countryPreference String?
  intake            String?
  status            StudentStatus @default(LEAD)

  mentorships  Mentorship[]
  followUps    FollowUp[]
  applications Application[]
  documents    Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MentorProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  expertise String?
  isActive  Boolean @default(true)

  mentorships Mentorship[]
  followUps   FollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////
// CORE CRM MODELS
//////////////////////

model Mentorship {
  id        String @id @default(uuid())

  studentId String
  mentorId  String

  student StudentProfile @relation(fields: [studentId], references: [id])
  mentor  MentorProfile  @relation(fields: [mentorId], references: [id])

  status   MentorshipStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([studentId, mentorId])
}

model FollowUp {
  id        String @id @default(uuid())

  studentId String
  mentorId  String

  student StudentProfile @relation(fields: [studentId], references: [id])
  mentor  MentorProfile  @relation(fields: [mentorId], references: [id])

  note             String
  followUpDate     DateTime
  nextFollowUpDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id        String @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])

  universityName String
  country        String
  program        String
  intake         String
  status         ApplicationStatus @default(APPLIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id        String @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])

  type    DocumentType
  fileUrl String

  uploadedAt DateTime @default(now())
}
enum QuestionCategory {
  MANDATORY_INTRO
  UK_CHOICE
  UNIVERSITY_SPECIFIC
  COURSE_SPECIFIC
  FINANCE_SPONSORSHIP
  CAREER_PROGRESSION
  VISA_COMPLIANCE
}

model University {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  city             String
  londonLivingCost Int        @default(1529)
  questions        Question[]
  courses          Course[]
}

model Course {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  title        String
  level        String
  tuitionFee   Int
}

model Question {
  id               String           @id @default(cuid())
  universityId     String?
  university       University?      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  category         QuestionCategory
  timeLimitSec     Int              @default(60)
  questionTemplate String
}